# Customize by copying to models.yml (gitignored) and editing:
#   cp models.yml.default models.yml
# Then (re-)run:  ./tasks/sync-models.py

env:
  - name: MODEL_DIR
    value: ${HOME}/.cache/huggingface/hub

providers:
  - name: local
    baseUrl: http://localhost:9292/v1
    apiKey: not-required
    models:
      - name: qwen3.8-27b
        type: local
        download:
          - "hf download hf://unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q4_K_XL.gguf"
          - "hf download hf://unsloth/Qwen3.8-27B-GGUF/mmproj-BF16.gguf"
        serve:
          # ${llama-server-bin} is a llama-swap macro defined in the config
          # generated by setup-llama-swap.sh (/usr/local/bin/llama-server).
          cmd: |
            ${llama-server-bin}
            --port ${PORT}
            -m ${models-dir-hf}/models--unsloth--Qwen3.8-27B-GGUF/snapshots/latest/Qwen3.8-27B-UD-Q4_K_XL.gguf
            --mmproj ${models-dir-hf}/models--unsloth--Qwen3.8-27B-GGUF/snapshots/latest/mmproj-BF16.gguf
            --ctx-size 262144
            --jinja
            --top-p '0.95'
            --top-k '20'
            --min-p '0.0'
            --temp '1.0'
            --spec-type draft-mtp
            --spec-draft-n-max 4
            --cache-type-k q8_0
            --cache-type-v q8_0
            --verbose
        agent:
          contextWindow: 262144
          maxTokens: 16000
          reasoning: true
          input: [text, image]
          thinkingLevelMap:
            minimal: null
            low: low
            medium: medium
            high: null
            xhigh: xhigh
            max: null
